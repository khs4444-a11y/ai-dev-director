{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "patch",
            "test_log",
            "review",
            "manifest"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "kind"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Provider": {
      "enum": [
        "codex",
        "claude",
        "gemini",
        "antigravity"
      ],
      "title": "Provider",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "provider": {
      "$ref": "#/$defs/Provider"
    },
    "status": {
      "enum": [
        "ok",
        "timeout",
        "unavailable",
        "invalid_output",
        "error",
        "cancelled"
      ],
      "title": "Status",
      "type": "string"
    },
    "summary": {
      "title": "Summary",
      "type": "string"
    },
    "artifacts": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "title": "Artifacts",
      "type": "array"
    },
    "exit_code": {
      "anyOf": [
        {
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exit Code"
    },
    "elapsed_seconds": {
      "minimum": 0,
      "title": "Elapsed Seconds",
      "type": "number"
    }
  },
  "required": [
    "request_id",
    "provider",
    "status",
    "summary",
    "elapsed_seconds"
  ],
  "title": "AgentResponse",
  "type": "object"
}
