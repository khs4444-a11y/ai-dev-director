{
  "$defs": {
    "Artifact": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0",
          "default": "1.0",
          "title": "Schema Version",
          "type": "string"
        },
        "relative_path": {
          "title": "Relative Path",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[0-9a-f]{64}$",
          "title": "Sha256",
          "type": "string"
        },
        "kind": {
          "enum": [
            "patch",
            "test_log",
            "review",
            "manifest"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "relative_path",
        "sha256",
        "kind"
      ],
      "title": "Artifact",
      "type": "object"
    },
    "Gate": {
      "enum": [
        "plan",
        "red",
        "green",
        "refactor",
        "verify"
      ],
      "title": "Gate",
      "type": "string"
    },
    "Provider": {
      "enum": [
        "codex",
        "claude",
        "gemini",
        "antigravity"
      ],
      "title": "Provider",
      "type": "string"
    },
    "Role": {
      "enum": [
        "planner",
        "builder",
        "reviewer"
      ],
      "title": "Role",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "task_id": {
      "format": "uuid",
      "title": "Task Id",
      "type": "string"
    },
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "gate": {
      "$ref": "#/$defs/Gate"
    },
    "attempt": {
      "minimum": 1,
      "title": "Attempt",
      "type": "integer"
    },
    "candidate_commit": {
      "pattern": "^[0-9a-f]{40}([0-9a-f]{24})?$",
      "title": "Candidate Commit",
      "type": "string"
    },
    "outcome": {
      "enum": [
        "pass",
        "fail",
        "blocked"
      ],
      "title": "Outcome",
      "type": "string"
    },
    "actor_role": {
      "$ref": "#/$defs/Role"
    },
    "actor_provider": {
      "$ref": "#/$defs/Provider"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/Artifact"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    },
    "reason": {
      "minLength": 1,
      "title": "Reason",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "request_id",
    "gate",
    "attempt",
    "candidate_commit",
    "outcome",
    "actor_role",
    "actor_provider",
    "evidence",
    "reason"
  ],
  "title": "GateResult",
  "type": "object"
}
